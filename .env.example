DATABASE_URL=postgres://USER:PASSWORD@db.prisma.io:5432/?sslmode=require
SECRET_KEY=python3 -c "import secrets; print(secrets.token_urlsafe(32))"
DEBUG=true

# Paystack (payments & escrow)
# Replace with your own keys in your private .env file
PAYSTACK_PUBLIC_KEY="your_public_key_here"
PAYSTACK_SECRET_KEY="your_secret_key_here"

# Database
DB_USER=admin
DB_PASSWORD=Password123!
DB_HOST=localhost
DB_PORT=5432

# Email (SMTP)
MAIL_PORT=587
MAIL_USERNAME=""
MAIL_PASSWORD=""
MAIL_DEFAULT_SENDER="Studybuddy Africa"
MAIL_USE_TLS=true
MAIL_USE_SSL=false

# When DEBUG=true, true prints emails to console; false sends through SMTP
MAIL_DEBUG_CONSOLE=true

SEND_TOKEN=""
INTASEND_PUBLISHABLE_KEY=""
DAILY_API_KEY=""
DAILY_ROOM_URL_BASE=""
JITSU_API_KEY=""
JITSU_API_URL=""
EXCALIDRAW_API_KEY=""
EXCALIDRAW_API_URL="https://api.excalidraw.com"
EXCALIDRAW_APP_URL="https://excalidraw.com/"
DEFAULT_WHITEBOARD_LINK="https://excalidraw.com/"